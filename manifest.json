{
  "manifest_version": 2,
  "name": "Claude Mail Sorter",
  "description": "Uses Claude to file emails into folders, catch spam, flag important mail, and apply tags.",
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "version": "0.4.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-mail-sorter@webstas",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "browser_action": {
    "default_title": "Claude Mail Sorter settings",
    "default_icon": "icons/icon.svg"
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesTagsList",
    "messagesTags",
    "accountsFolders",
    "menus",
    "notifications",
    "storage",
    "https://api.anthropic.com/*"
  ]
}
